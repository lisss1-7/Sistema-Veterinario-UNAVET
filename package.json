{
  "name": "unavet-prototipo",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:backend\"",
    "dev:first-delivery": "concurrently \"vite --mode first-delivery\" \"npm run dev:backend\"",
    "dev:full": "concurrently \"vite --mode full\" \"npm run dev:backend\"",
    "dev:frontend": "vite",
    "dev:backend": "npm run dev --prefix backend",
    "build": "vite build",
    "build:first-delivery": "vite build --mode first-delivery",
    "build:full": "vite build --mode full",
    "preview": "vite preview",
    "test": "node --test src/app/utils/*.test.js && npm test --prefix backend",
    "audit:security": "npm audit && npm audit --prefix backend"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.1.6",
    "@radix-ui/react-dialog": "1.1.6",
    "@radix-ui/react-popover": "1.1.6",
    "@radix-ui/react-select": "2.1.6",
    "jspdf": "^4.2.1",
    "lucide-react": "0.487.0",
    "next-themes": "0.4.6",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "react-router": "^7.18.4",
    "sonner": "2.0.3",
    "tw-animate-css": "1.3.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.1.12",
    "@vitejs/plugin-react": "4.7.0",
    "concurrently": "^10.0.3",
    "tailwindcss": "4.1.12",
    "vite": "^6.4.3"
  },
  "peerDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "pnpm": {
    "overrides": {
      "vite": "6.4.3"
    }
  }
}

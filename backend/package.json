    "migrate:remove-runtime-tables": "node src/scripts/removeRuntimeTables.js",
    "migrate:normalize": "node src/scripts/normalizeBusinessData.js",
    "migrate:structural-integrity": "node src/scripts/normalizeStructuralIntegrity.js",
    "migrate:catalog-references": "node src/scripts/normalizeCatalogReferences.js",
    "migrate:clinical-people-dates": "node src/scripts/normalizeClinicalPeopleAndDates.js",
    "migrate:clinical-modules": "node src/scripts/normalizeClinicalModules.js",
    "migrate:inventory-lots": "node src/scripts/normalizeInventoryLots.js",
    "migrate:remove-unit-abbreviation": "node src/scripts/removeUnitAbbreviation.js",
    "migrate:remaining-integrity": "node src/scripts/normalizeRemainingIntegrity.js",

    "test:person-names": "node src/scripts/smokePersonNames.js",
    "test": "node --test tests/*.test.js",
    "test:users": "node --test tests/usuariosSoftDelete.test.js",
    "test:attribution": "node --test tests/recordAttribution.test.js",
    "test:reports": "node --test tests/aiReports.test.js"

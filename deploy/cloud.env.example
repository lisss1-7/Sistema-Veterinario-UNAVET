# Plantilla para deploy/.env.cloud. Completar solo en el servidor.
# No contiene credenciales reales. Los campos CAMBIAR son obligatorios.
NODE_ENV=production
PORT=3001
SERVE_FRONTEND=true
TZ=America/Guatemala

# Usar el hostname privado del servidor MySQL y el nombre del esquema importado.
DB_HOST=CAMBIAR_HOST_MYSQL
DB_PORT=3306
DB_USER=CAMBIAR_USUARIO_MYSQL
DB_PASSWORD=CAMBIAR_PASSWORD_MYSQL
DB_NAME=CAMBIAR_NOMBRE_ESQUEMA
DB_CONNECTION_LIMIT=10
DB_SSL=true
# Si el certificado necesita una CA privada, montar el archivo en el contenedor
# y activar DB_SSL_CA_PATH con su ruta dentro del contenedor. Ver ORACLE.md.
# DB_SSL_CA_PATH=/app/backend/certs/mysql-ca.pem

# Tres valores aleatorios diferentes, de al menos 32 caracteres cada uno.
JWT_SECRET=CAMBIAR_SECRETO_JWT
PASSWORD_RESET_SECRET=CAMBIAR_SECRETO_RECUPERACION
MEDIA_SIGNING_SECRET=CAMBIAR_SECRETO_ARCHIVOS

FRONTEND_URL=https://CAMBIAR_SUBDOMINIO.duckdns.org
MEDIA_STORAGE_PATH=/app/backend/storage/media

# Datos de tu proveedor de correo. El backend los exige en produccion.
# Puerto 587: SMTP_SECURE=false (STARTTLS). Puerto 465: SMTP_SECURE=true.
SMTP_HOST=CAMBIAR_HOST_SMTP
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=CAMBIAR_USUARIO_SMTP
SMTP_PASS=CAMBIAR_PASSWORD_SMTP
SMTP_FROM='UNAVET <CAMBIAR_REMITENTE>'

# Si usas informes de IA, agregar aqui las variables del proveedor que ya usas.
# El alojamiento no incluye el consumo de servicios externos de IA.
